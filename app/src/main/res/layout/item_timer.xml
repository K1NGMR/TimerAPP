<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/card_background"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:gravity="center_vertical">

    <!-- Mini Circular Progress Indicator -->
    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="16dp">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/itemProgress"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            app:indicatorSize="44dp"
            app:trackThickness="4dp"
            app:trackColor="#1AFFFFFF"
            app:indicatorColor="@color/primary"
            app:trackCornerRadius="2dp"
            android:progress="100" />

        <ImageView
            android:id="@+id/itemStatusIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:src="@android:drawable/ic_media_play"
            android:contentDescription="Status"/>
    </FrameLayout>

    <!-- Timer Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/itemLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Timer Label"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/itemTimeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Controls Actions -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Play / Pause Button -->
        <ImageView
            android:id="@+id/itemBtnToggle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_media_play"
            android:background="@drawable/preset_chip"
            android:padding="8dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="Start/Stop"
            android:clickable="true"
            android:focusable="true"/>

        <!-- Restart Button -->
        <ImageView
            android:id="@+id/itemBtnRestart"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_rotate"
            android:background="@drawable/preset_chip"
            android:padding="8dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="Restart"
            android:clickable="true"
            android:focusable="true"/>

        <!-- Delete Button -->
        <ImageView
            android:id="@+id/itemBtnDelete"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="@drawable/preset_chip"
            android:padding="8dp"
            android:contentDescription="Delete"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

</LinearLayout>
