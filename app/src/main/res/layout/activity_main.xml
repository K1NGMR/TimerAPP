<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_dark"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal"
        android:animateLayoutChanges="true">

        <!-- Header -->
        <TextView
            android:id="@+id/appTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="AURA TIMER"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <!-- Theme Selector Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="THEME COLOR"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/themeSunset"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="36dp"
                    android:background="@drawable/preset_chip"
                    android:text="Sunset"
                    android:textColor="#E94057"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="6dp"
                    app:backgroundTint="@null"/>

                <Button
                    android:id="@+id/themeCyberpunk"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="36dp"
                    android:background="@drawable/preset_chip"
                    android:text="Cyber"
                    android:textColor="#8A2387"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="6dp"
                    app:backgroundTint="@null"/>

                <Button
                    android:id="@+id/themeOcean"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="36dp"
                    android:background="@drawable/preset_chip"
                    android:text="Ocean"
                    android:textColor="#00E5FF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="6dp"
                    app:backgroundTint="@null"/>

                <Button
                    android:id="@+id/themeForest"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="36dp"
                    android:background="@drawable/preset_chip"
                    android:text="Forest"
                    android:textColor="#10B981"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:backgroundTint="@null"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Configuration Card (Glass Container to Add Timers) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginTop="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CREATE NEW TIMER"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <!-- Name Input Field -->
            <EditText
                android:id="@+id/editTimerLabel"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/preset_chip"
                android:hint="Timer Label (e.g. Study, Coffee)"
                android:textColorHint="@color/text_muted"
                android:textColor="@color/text_primary"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textSize="14sp"
                android:layout_marginBottom="12dp"
                android:maxLines="1"
                android:singleLine="true"/>

            <!-- Custom Time Picker Grid -->
            <LinearLayout
                android:id="@+id/pickerContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_weight="1">
                    <EditText
                        android:id="@+id/editHours"
                        android:layout_width="60dp"
                        android:layout_height="48dp"
                        android:background="@drawable/preset_chip"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="2"
                        android:text="00"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HOURS"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":"
                    android:textColor="@color/text_secondary"
                    android:textSize="24sp"
                    android:layout_marginBottom="16dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_weight="1">
                    <EditText
                        android:id="@+id/editMinutes"
                        android:layout_width="60dp"
                        android:layout_height="48dp"
                        android:background="@drawable/preset_chip"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="2"
                        android:text="05"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MINUTES"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=":"
                    android:textColor="@color/text_secondary"
                    android:textSize="24sp"
                    android:layout_marginBottom="16dp"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_weight="1">
                    <EditText
                        android:id="@+id/editSeconds"
                        android:layout_width="60dp"
                        android:layout_height="48dp"
                        android:background="@drawable/preset_chip"
                        android:gravity="center"
                        android:inputType="number"
                        android:maxLength="2"
                        android:text="00"
                        android:textColor="@color/text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SECONDS"
                        android:textSize="10sp"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Preset Chips list -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QUICK PRESETS"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:id="@+id/presetsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- Presets will go here dynamically -->
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Preset Creator Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <EditText
                    android:id="@+id/editPresetName"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="36dp"
                    android:background="@drawable/preset_chip"
                    android:hint="Preset name (eg Tea)"
                    android:textColorHint="@color/text_muted"
                    android:textColor="@color/text_primary"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:layout_marginEnd="6dp"/>

                <Button
                    android:id="@+id/btnSavePreset"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="SAVE PRESET"
                    android:textColor="@color/accent_blue"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:background="@drawable/preset_chip"
                    app:backgroundTint="@null"/>
            </LinearLayout>

            <!-- Add / Create Trigger Button -->
            <Button
                android:id="@+id/btnCreateTimer"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/btn_gradient"
                android:text="ADD TIMER"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />
        </LinearLayout>

        <!-- Alarm Sound Picker Card -->
        <LinearLayout
            android:id="@+id/soundContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ALARM SOUND (LOOPS &amp; FADES IN)"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/card_background"
                android:padding="12dp">

                <TextView
                    android:id="@+id/textSoundName"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Default Ringtone"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:layout_marginEnd="8dp"/>

                <Button
                    android:id="@+id/btnSelectSound"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="SELECT"
                    android:textColor="@color/accent_blue"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/preset_chip"
                    android:layout_marginEnd="4dp"
                    app:backgroundTint="@null"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Configured Active Timers Section Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ACTIVE TIMERS"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"/>

        <!-- RecyclerView containing multiple active timers -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerTimers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            tools:listitem="@layout/item_timer" />

    </LinearLayout>
</ScrollView>
