<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floatingRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/card_background"
    android:padding="8dp"
    android:gravity="center_vertical"
    android:elevation="8dp">

    <!-- Drag Handle Indicator -->
    <TextView
        android:id="@+id/dragHandle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⋮⋮"
        android:textColor="@color/text_muted"
        android:textSize="18sp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"
        android:clickable="true"
        android:focusable="true"/>

    <!-- Countdown Text -->
    <TextView
        android:id="@+id/floatTimeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginEnd="12dp"/>

    <!-- Mini Restart Button -->
    <ImageView
        android:id="@+id/floatBtnRestart"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@android:drawable/ic_menu_rotate"
        android:background="@drawable/preset_chip"
        android:padding="4dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="Restart"
        android:clickable="true"
        android:focusable="true"/>

    <!-- Mini Stop/Close Button -->
    <ImageView
        android:id="@+id/floatBtnStop"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:background="@drawable/preset_chip"
        android:padding="4dp"
        android:layout_marginEnd="4dp"
        android:contentDescription="Stop"
        android:clickable="true"
        android:focusable="true"/>

</LinearLayout>
